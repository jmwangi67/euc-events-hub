{
  "name": "euc-events-hub",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write app components lib data tests .github package.json tsconfig.json *.mjs *.ts README.md",
    "format:check": "prettier --check app components lib data tests .github package.json tsconfig.json *.mjs *.ts README.md",
    "test:browser": "playwright test",
    "exams:import": "node exam-tools.mjs import",
    "exams:validate": "node exam-tools.mjs validate",
    "exams:audit-build": "node exam-tools.mjs audit-build",
    "test:exam-preview": "playwright test --config playwright.exam-preview.config.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fullcalendar/core": "6.1.22",
    "@fullcalendar/daygrid": "6.1.22",
    "@fullcalendar/list": "6.1.22",
    "@fullcalendar/luxon3": "6.1.22",
    "@fullcalendar/react": "6.1.22",
    "@fullcalendar/timegrid": "6.1.22",
    "luxon": "3.7.2",
    "next": "16.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.1",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  },
  "type": "module"
}
